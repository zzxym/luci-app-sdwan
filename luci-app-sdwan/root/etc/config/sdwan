
config sdwan
	option enabled '0'
	option etcmd 'etcmd'
	option sdwanbin '/usr/bin/sdwan-core'
	option auto_config_interface '1'
	option auto_config_firewall '1'
	option interface_netmask '255.0.0.0'
	option web_enabled '0'
	option webbin '/usr/bin/sdwan-web'
	option network_name 'xlxxadmin'
	option network_secret 'Aa123456'
	option ip_dhcp '1'
	option listenermode 'ON'
	option tcp_port '10010'
	option ws_port '10011'
	option wss_port '10012'
	option wg_port '10011'
	option quic_port '10012'
	option rpc_portal '15888'
	option default_protocol 'udp'
	option latency_first '1'
	option multi_thread '1'
	option smoltcp '1'
	option exit_node '1'
	option kcp_proxy '1'
	option bind_device '1'
	option relay_network '1'
	list whitelist '*'
	list peeradd 'tcp://oa.xiaolin.cc:10010'
	list peeradd 'udp://oa.xiaolin.cc:10010'
	list peeradd 'tcp://sdwan.xiaolin.cc:10010'
	list peeradd 'udp://sdwan.xiaolin.cc:10010'
	list peeradd 'tcp://jpnode1.xldns.top:16684'
	list peeradd 'udp://jpnode1.xldns.top:16684'
	list peeradd 'tcp://sghko.xldns.top:16684'
	list peeradd 'udp://sghko.xldns.top:16684'
	option web_config 'udp://oa.xiaolin.cc:22020/xlxxadmin'
	option web_api_host 'http://oa.xiaolin.cc:11211'
